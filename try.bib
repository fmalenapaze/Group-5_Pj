	pages = {401--404},
	file = {Eingereichte Version:/Users/majaewen/Zotero/storage/AQS3YDUS/Cerami et al. - 2012 - The cBio Cancer Genomics Portal An Open Platform for Exploring Multidimensional Cancer Genomics Dat.pdf:application/pdf},
