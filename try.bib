
@article{casper_ucsc_2026,
	title = {The {UCSC} {Genome} {Browser} database: 2026 update},
	volume = {54},
	copyright = {https://creativecommons.org/licenses/by/4.0/},
	issn = {0305-1048, 1362-4962},
	shorttitle = {The {UCSC} {Genome} {Browser} database},
	url = {https://academic.oup.com/nar/article/54/D1/D1331/8326455},
	doi = {10.1093/nar/gkaf1250},
	abstract = {Abstract Now in its 25th year of operation, the UCSC Genome Browser (https://genome.ucsc.edu) provides a central location for researchers around the world to display and compare annotations on assembled genomes. Highlighted updates include a positional heatmap display, used to show data on functional consequences of mutation from MaveDB; QuickLift, a tool to copy annotation data seen on one assembly for display on another related assembly; and HubSpace, an initiative to simplify the process of creating and using track hubs by providing each user account with dedicated storage on UCSC’s infrastructure.},
	language = {en},
	number = {D1},
	urldate = {2026-10-11},
	journal = {Nucleic Acids Research},
	author = {Casper, Jonathan and Speir, Matthew L and Raney, Brian J and Perez, Gerardo and Nassar, Luis R and Lee, Christopher M and Hinrichs, Angie S and Gonzalez, Jairo Navarro and Fischer, Clay and Diekhans, Mark and Clawson, Hiram and Benet-Pages, Anna and Barber, Galt P and Vaske, Charles J and van Baren, Marijke J and Wang, Karen and Rodriguez, Yesenia Joanna Puga and Jenkins-Kiefer, Jaidan Ashlyn and Chalamala, Megna and Haussler, David and Kent, William James and Haeussler, Maximilian},
	month = jan,
